<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Bakterizid @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3-Plugin" description="Für Ableton Live, Bitwig, Cubase, FL Studio, Reaper, Studio One und die meisten anderen DAWs.">
        <pkg-ref id="com.sarin.bakterizid.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Für Logic Pro und GarageBand.">
        <pkg-ref id="com.sarin.bakterizid.au"/>
    </choice>
    <choice id="app" title="Standalone-App" description="Bakterizid ohne DAW spielen. Landet im Programme-Ordner.">
        <pkg-ref id="com.sarin.bakterizid.app"/>
    </choice>
    <pkg-ref id="com.sarin.bakterizid.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.sarin.bakterizid.au" version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.sarin.bakterizid.app" version="@VERSION@">app.pkg</pkg-ref>
</installer-gui-script>
